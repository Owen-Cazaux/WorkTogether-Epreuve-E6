{% extends 'base.html.twig' %}

{% block title %}Mon profil — WorkTogether{% endblock %}

{% block body %}
    <header class="site-header">
        <nav class="navigation" aria-label="Navigation principale">
            <a class="brand" href="{{ path('app_home') }}" aria-label="WorkTogether, accueil">
                <span class="brand-mark" aria-hidden="true">W</span>
                <span>WorkTogether</span>
            </a>
            <div class="nav-links">
                <a href="{{ path('app_nos_offres') }}">Nos offres</a>
                <a href="{{ path('app_unites') }}">Mes unités</a>
                <a class="nav-login" href="{{ logout_path() }}">Déconnexion</a>
            </div>
        </nav>
    </header>


    <main  class="profile-page section-shell">
        <div class="profile-intro">
            <p class="eyebrow">VOTRE ESPACE WORKTOGETHER</p>
            <h1>Mon profil</h1>
            <p class="inventory-intro">Consultez les informations associées à votre compte.</p>
        </div>

        <script src="{{ asset('js/cacher.js') }}" defer></script>
        <section class="profile-card" aria-labelledby="profile-card-title">
            <div class="profile-card-heading">
                <span class="profile-avatar" aria-hidden="true">{{ utilisateur.prenom|first }}{{ utilisateur.nom|first }}</span>
                <div>
                    <p class="inventory-card-label">INFORMATIONS PERSONNELLES</p>
                            <h2 id="profile-card-title">{{ utilisateur.prenom}} {{ utilisateur.nom }}</h2>
                </div>
            </div>

            <dl class="profile-details">
                <div class="profile-detail">
                    <dt>Prénom</dt>
                        <dd>{{ utilisateur.prenom }}</dd>
                </div>
                <div class="profile-detail">
                    <dt>Nom</dt>
                            <dd>{{ utilisateur.nom }}</dd>
                </div>
                <div class="profile-detail">
                    <dt>Adresse e-mail</dt>
                            <dd>{{ utilisateur.email }}</dd>
                </div>
                {% if utilisateur.roles == ["ROLE_CLIENT", "ROLE_USER"] %}
                    <div class="profile-detail">
                        <dt>Numéro de téléphone</dt>
                                <dd>{{ utilisateur.telephone }}</dd>
                    </div>
                    <div class="profile-detail">
                        <dt>Mot de passe</dt>
                        <dd aria-label="Mot de passe masqué">********</dd>
                    </div>
                    <div class="profile-detail">
                        <dt>Adresse</dt>
                            <dd>{{ utilisateur.adresse }}</dd>
                    </div>
                    <div class="profile-detail">
                        <dt>Code postal</dt>
                            <dd>{{ utilisateur.codePostal }}</dd>
                    </div>
                    <div class="profile-detail">
                        <dt>Ville</dt>
                            <dd>{{ utilisateur.ville }}</dd>
                    </div>
                    <div class="profile-detail">
                        <dt>Pays</dt>
                            <dd>{{ utilisateur.pays }}</dd>
                    </div>
                {% endif %}
                <div class="profile-detail">
                    <dt>Membre depuis</dt>
                    <dd>{{ utilisateur.dateCreation|date('d/m/Y') }}</dd>
                </div>
            </dl>

            <div class="profile-card-actions">
                <button id="edit-button" class="button button-primary" type="button">Modifier mon profil</button>
            </div>
        </section>

        <section class="profile-card hidden" aria-labelledby="profile-card-title">
            <div class="profile-card-heading">
                <span class="profile-avatar" aria-hidden="true">{{ utilisateur.prenom|first }}{{ utilisateur.nom|first }}</span>
                <div>
                    <p class="inventory-card-label">INFORMATIONS PERSONNELLES</p>
                    <h2 id="profile-card-title">{{ utilisateur.prenom}} {{ utilisateur.nom }}</h2>
                </div>
            </div>

            <dl class="profile-details">
                <div class="profile-detail">
                    <label for="profile-first-name">Prénom</label>
                    <input id="profile-first-name" type="text" value="{{ utilisateur.prenom}}">
                </div>
                <div class="profile-detail">
                    <label for="profile-last-name">Nom</label>
                    <input id="profile-last-name" type="text" value="{{ utilisateur.nom }}">
                </div>
                <div class="profile-detail">
                    <label for="profile-email">Email</label>
                    <input id="profile-email" type="text" value="{{ utilisateur.email }}">
                </div>
                {% if utilisateur.roles == ["ROLE_CLIENT", "ROLE_USER"] %}
                    <div class="profile-detail">
                        <label for="profile-phone">Téléphone</label>
                        <input id="profile-phone" type="text" value="{{ utilisateur.telephone }}">
                    </div>
                    <div class="profile-detail">
                        <label for="profile-password">Mot de passe</label>
                        <input id="profile-password" type="text">
                    </div>
                    <div class="profile-detail">
                        <label for="profile-address">Adresse</label>
                        <input id="profile-address" type="text" value="{{ utilisateur.adresse }}">
                    </div>
                    <div class="profile-detail">
                        <label for="profile-postal-code">Code postal</label>
                        <input id="profile-postal-code" type="text" value="{{ utilisateur.codePostal }}">
                    </div>
                    <div class="profile-detail">
                        <label for="profile-city">Ville</label>
                        <input id="profile-city" type="text" value="{{ utilisateur.ville}}">
                    </div>
                    <div class="profile-detail">
                        <label for="profile-country">Pays</label>
                        <input id="profile-country" type="text" value="{{ utilisateur.pays}}">
                    </div>
                {% endif %}
                <div class="profile-detail">
                    <dt>Membre depuis</dt>
                    <dd>{{ utilisateur.dateCreation|date('d/m/Y') }}</dd>
                </div>

                <div class="profile-card-actions">
                    <button id="valid-button" class="button button-primary" type="button">Valider</button>
                </div>
            </dl>


        </section>
    </main>
{% endblock %}
