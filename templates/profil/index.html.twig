{% extends 'base.html.twig' %}

{% block title %}Mon profil — WorkTogether{% endblock %}

{% block body %}
    <header class="site-header">
        <nav class="navigation" aria-label="Navigation principale">
            <a class="brand" href="{{ path('app_home') }}" aria-label="WorkTogether, accueil">
                <span class="brand-mark" aria-hidden="true">W</span>
                <span>WorkTogether</span>
            </a>
            <div class="nav-links">
                <a href="{{ path('app_baies') }}">Mes baies</a>
                <a href="{{ path('app_unites') }}">Mes unités</a>
                <a class="nav-login" href="{{ logout_path() }}">Déconnexion</a>
            </div>
        </nav>
    </header>

    <main class="profile-page section-shell">
        <p class="eyebrow">VOTRE ESPACE WORKTOGETHER</p>
        <h1>Mon profil</h1>
        <p class="inventory-intro">Consultez les informations associées à votre compte.</p>

        <section class="profile-card" aria-labelledby="profile-card-title">
            <div class="profile-card-heading">
                <span class="profile-avatar" aria-hidden="true">{{ utilisateur.prenom|first ~ utilisateur.nom|first }}</span>
                <div>
                    <p class="inventory-card-label">INFORMATIONS PERSONNELLES</p>
                    <h2 id="profile-card-title">{{ utilisateur.prenom}} {{ utilisateur.nom }}</h2>
                </div>
            </div>

            <dl class="profile-details">
                <div class="profile-detail">
                    <dt>Prénom</dt>
                    <dd>{{ utilisateur.prenom }}</dd>
                </div>
                <div class="profile-detail">
                    <dt>Nom</dt>
                    <dd>{{ utilisateur.nom }}</dd>
                </div>
                <div class="profile-detail">
                    <dt>Adresse e-mail</dt>
                    <dd>{{ utilisateur.email }}</dd>
                </div>
                <div class="profile-detail">
                    <dt>Membre depuis</dt>
                    <dd>{{ utilisateur.dateCreation|date('d/m/Y') }}</dd>
                </div>
            </dl>

            <div class="profile-card-actions">
                <button class="button button-primary" type="button">Modifier mon profil</button>
                <span>La modification du profil sera bientôt disponible.</span>
            </div>
        </section>
    </main>
{% endblock %}
