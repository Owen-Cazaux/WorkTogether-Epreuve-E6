{% extends 'base.html.twig' %}

{% block title %}Hello EditMotDePasseController!{% endblock %}

{% block body %}
    <header class="site-header">
        <nav class="navigation" aria-label="Navigation principale">
            <a class="brand" href="{{ path('app_home') }}" aria-label="WorkTogether, accueil">
                <span class="brand-mark" aria-hidden="true">W</span>
                <span>WorkTogether</span>
            </a>
            <div class="nav-links">
                <a href="{{ path('app_nos_offres') }}">Nos offres</a>
                <a href="{{ path('app_unites') }}">Mes unités</a>
                <a class="nav-login" href="{{ logout_path() }}">Déconnexion</a>
            </div>
        </nav>
    </header>
    <section class=" profile-card profile-edit-card">
        <div class="profile-card-heading">
            <span class="profile-avatar" aria-hidden="true">{{ utilisateur.prenom|first }}{{ utilisateur.nom|first }}</span>
            <div>
                <h2 id="profile-edit-title">Modifier mon mot de passe</h2>
            </div>
        </div>
        {{ form_start(form, {attr: {'data-turbo': 'false', class: 'login-form register-form profile-edit-form'}}) }}
        {{ form_row(form.motDePasseActuel, {row_attr: {class: 'register-field'}}) }}
        {{ form_row(form.nouveauMotDePasse) }}
        {{ form_row(form.submit, {row_attr: {class: 'register-submit'}}) }}
        {{ form_end(form) }}
    </section>
{% endblock %}
