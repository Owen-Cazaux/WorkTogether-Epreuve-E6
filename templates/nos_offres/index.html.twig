{% extends 'base.html.twig' %}

{% block title %}Nos offres — WorkTogether{% endblock %}

{% block body %}
    <header class="site-header">
        <nav class="navigation" aria-label="Navigation principale">
            <a class="brand" href="{{ path('app_home') }}" aria-label="WorkTogether, accueil">
                <span class="brand-mark" aria-hidden="true">W</span>
                <span>WorkTogether</span>
            </a>
            <div class="nav-links">
                <a class="inventory-tab inventory-tab-active" href="{{ path('app_nos_offres') }}" aria-current="page">Nos offres</a>
                {% if app.user %}
                    <a class="inventory-tab" href="{{ path('app_baies') }}">Mes baies</a>
                    <a class="inventory-tab" href="{{ path('app_unites') }}">Mes unités</a>
                    <a href="{{ path('app_profil') }}">Mon profil</a>
                    <a class="nav-login" href="{{ logout_path() }}">Déconnexion</a>
                {% else %}
                    <a class="nav-login" href="{{ path('app_connexion') }}">Connexion</a>
                    <a class="nav-register" href="{{ path('app_inscription') }}">Inscription</a>
                {% endif %}
            </div>
        </nav>
    </header>

    <main class="offers-page section-shell">
        <section class="offers-intro" aria-labelledby="offers-title">
            <p class="eyebrow">NOS SOLUTIONS</p>
            <h1 id="offers-title">Nos offres</h1>
            <p class="offers-lead">
                Choisissez la capacité adaptée à votre infrastructure. Chaque offre comprend
                un tarif mensuel avantageux, avec une remise supplémentaire sur l'engagement annuel.
            </p>
        </section>

        <section class="offers-grid" aria-label="Les quatre offres WorkTogether">
            {% for offre in nos_offres %}
                <article class="offer-card offer-card-base">
                    <div class="offer-card-heading">
                        <div>
                            <p class="offer-card-label">OFFRE {{ loop.index }}</p>
                            <h2>{{ offre.nom }}</h2>
                        </div>
                        <span class="offer-unit-count"> {{ offre.nombreUnites }}</span>
                    </div>
                    <div class="offer-price">
                        <span class="offer-price-label">Tarif mensuel</span>
                        <p><strong>{{ offre.prixMensuel}} €</strong><span> / mois</span></p>
                    </div>
                    <div class="offer-price offer-price-annual">
                        <span class="offer-price-label">Engagement annuel <span class="offer-discount">−{{ offre.remiseAnnuellePourcentage}} %</span></span>
                        <p><strong>{{ (offre.prixMensuel * 12) * (1 - offre.remiseAnnuellePourcentage/100) }}  €</strong><span> / an</span></p>
                    </div>
                    <a class="offer-cta" href="{{ path('app_inscription') }}">Choisir cette offre <span aria-hidden="true">→</span></a>
                </article>
            {% endfor %}
        </section>

        <section class="offers-note" aria-label="Informations sur l'offre annuelle">
            <span class="offers-note-mark" aria-hidden="true">W</span>
            <div>
                <h2>Optez pour l'année, économisez davantage.</h2>
                <p>La remise annuelle varie de 10 % à 25 % selon l'offre choisie.</p>
            </div>
        </section>
    </main>
{% endblock %}
