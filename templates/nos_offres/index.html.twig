{% extends 'base.html.twig' %}

{% block title %}Nos offres — WorkTogether{% endblock %}

{% block body %}
    <header class="site-header">
        <nav class="navigation" aria-label="Navigation principale">
            <a class="brand" href="{{ path('app_home') }}" aria-label="WorkTogether, accueil">
                <span class="brand-mark" aria-hidden="true">W</span>
                <span>WorkTogether</span>
            </a>
            <div class="nav-links">
                <a class="inventory-tab inventory-tab-active" href="{{ path('app_nos_offres') }}" aria-current="page">Nos offres</a>
                {% if app.user %}
                    <a class="inventory-tab" href="{{ path('app_baies') }}">Mes baies</a>
                    <a class="inventory-tab" href="{{ path('app_unites') }}">Mes unités</a>
                    <a href="{{ path('app_profil') }}">Mon profil</a>
                    <a class="nav-login" href="{{ logout_path() }}">Déconnexion</a>
                {% else %}
                    <a class="nav-login" href="{{ path('app_connexion') }}">Connexion</a>
                    <a class="nav-register" href="{{ path('app_inscription') }}">Inscription</a>
                {% endif %}
            </div>
        </nav>
    </header>

    <main class="offers-page section-shell">
        <section class="offers-intro" aria-labelledby="offers-title">
            <p class="eyebrow">NOS SOLUTIONS</p>
            <h1 id="offers-title">Nos offres</h1>
            <p class="offers-lead">
                Des solutions pour héberger vos équipements, gérer votre infrastructure
                et avancer avec un accompagnement adapté.
            </p>
        </section>

        <section class="offers-grid" aria-label="Nos domaines d'offre">
            <article class="offer-card">
                <span class="offer-card-icon" aria-hidden="true">▦</span>
                <p class="offer-card-label">01 / HÉBERGEMENT</p>
                <h2>Hébergement &amp; baies</h2>
                <p>Un espace dédié pour accueillir vos équipements dans une infrastructure fiable.</p>
                <a href="{{ path('app_inscription') }}">Découvrir <span aria-hidden="true">→</span></a>
            </article>

            <article class="offer-card offer-card-featured">
                <span class="offer-card-icon" aria-hidden="true">⌁</span>
                <p class="offer-card-label">02 / ÉQUIPEMENTS</p>
                <h2>Unités &amp; ressources</h2>
                <p>Des ressources adaptées à vos besoins et une vision claire de vos unités.</p>
                <a href="{{ path('app_inscription') }}">Découvrir <span aria-hidden="true">→</span></a>
            </article>

            <article class="offer-card">
                <span class="offer-card-icon" aria-hidden="true">↗</span>
                <p class="offer-card-label">03 / ACCOMPAGNEMENT</p>
                <h2>Assistance technique</h2>
                <p>Un accompagnement humain pour l'installation, la maintenance et le suivi.</p>
                <a href="{{ path('app_inscription') }}">Découvrir <span aria-hidden="true">→</span></a>
            </article>
        </section>

        <section class="offers-note" aria-label="Besoin d'aide">
            <span class="offers-note-mark" aria-hidden="true">W</span>
            <div>
                <h2>Une question sur nos offres&nbsp;?</h2>
                <p>Créez votre espace WorkTogether pour découvrir votre environnement.</p>
            </div>
            <a class="button button-primary" href="{{ path('app_inscription') }}">
                Créer mon espace <span aria-hidden="true">→</span>
            </a>
        </section>
    </main>
{% endblock %}
