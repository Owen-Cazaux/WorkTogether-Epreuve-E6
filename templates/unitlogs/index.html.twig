{% extends 'base.html.twig' %}

{% block title %}Historique des interventions{% endblock %}

{% block body %}
    <header class="site-header">
        <nav class="navigation" aria-label="Navigation principale">
            <a class="brand" href="{{ path('app_home') }}" aria-label="WorkTogether, accueil">
                <span class="brand-mark" aria-hidden="true">W</span>
                <span>WorkTogether</span>
            </a>
            <div class="nav-links">
                <a href="{{ path('app_nos_offres') }}">Nos offres</a>
                <a href="{{ path('app_unites') }}">Mes unités</a>
                <a class="nav-login" href="{{ logout_path() }}">Déconnexion</a>
            </div>
        </nav>
    </header>
    <main class="inventory-page section-shell">
        <section>
            <h1>Historique des interventions</h1>
            <p class="inventory-intro">{{ unite.nom }}</p>
        </section>
        <div class="inventory-card">

            <ul class="liste-intervention">
                {% for intervention in interventions %}
                <li class="ligne-intervention">
                    <ul class="donnés-intervention">
                        <li>
                            {{ intervention.type }}
                        </li>
                        <li>
                            {{ intervention.description }}
                        </li>
                        <li>
                            {{ intervention.dateDebut|date('Y-m-d') }}
                        </li>
                        <li>
                            {{ intervention.dateFin|date('Y-m-d') }}
                        </li>
                    </ul>
                </li>
                {% endfor %}
            </ul>
        </div>
    </main>
{% endblock %}
