{% extends 'base.html.twig' %}

{% block title %}Inscription — WorkTogether{% endblock %}

{% block body %}
    <header class="login-header">
        <a class="brand" href="{{ path('app_home') }}" aria-label="WorkTogether, accueil">
            <span class="brand-mark" aria-hidden="true">W</span>
            <span>WorkTogether</span>
        </a>
        <a class="login-back-link" href="{{ path('app_home') }}">← Retour à l'accueil</a>
    </header>

    <main class="login-page">
        <section class="login-intro">
            <p class="eyebrow"><span class="eyebrow-dot"></span> Votre espace WorkTogether</p>
            <h1>Tout commence<br><span>ensemble.</span></h1>
            <p class="login-intro-copy">
                Créez votre espace WorkTogether et profitez d'un accompagnement adapté à votre entreprise.
            </p>
            <div class="login-benefit">
                <span class="note-icon" aria-hidden="true">✓</span>
                <span>Une infrastructure et une équipe à vos côtés.</span>
            </div>
            <div class="login-decoration" aria-hidden="true">
                <span class="decoration-ring ring-small"></span>
                <span class="decoration-ring ring-large"></span>
                <span class="decoration-dot"></span>
                <span class="decoration-label">WORK TOGETHER</span>
            </div>
        </section>

        <section class="login-card register-card" aria-labelledby="register-title">
            <div class="login-card-heading">
                <p class="eyebrow">ESPACE CLIENT</p>
                <h2 id="register-title">Créer un compte</h2>
                <p>Inscrivez-vous pour rejoindre WorkTogether.</p>
            </div>

            <div class="login-form-placeholder">
                {{ form_start(form, {attr: {class: 'login-form register-form'}}) }}
                {{ form_row(form.nom, {row_attr: {class: 'register-field'}}) }}
                {{ form_row(form.prenom, {row_attr: {class: 'register-field'}}) }}
                {{ form_row(form.email, {row_attr: {class: 'register-field register-field-wide'}}) }}
                {{ form_row(form.motDePasse, {row_attr: {class: 'register-field register-field-wide'}}) }}
                {{ form_row(form.submit, {row_attr: {class: 'register-submit'}}) }}
                {{ form_end(form) }}
            </div>

            <p class="login-help">Vous avez déjà un compte ? <a href="{{ path('app_connexion') }}">Se connecter</a></p>
        </section>
    </main>

    <footer class="login-footer">
        <span>© {{ "now"|date("Y") }} WorkTogether</span>
        <span>La technologie, en mieux.</span>
    </footer>
{% endblock %}
