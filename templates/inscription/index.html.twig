{% extends 'base.html.twig' %}

{% block title %}Inscription — WorkTogether{% endblock %}

{% block body %}
    <header class="login-header">
        <a class="brand" href="{{ path('app_home') }}" aria-label="WorkTogether, accueil">
            <span class="brand-mark" aria-hidden="true">W</span>
            <span>WorkTogether</span>
        </a>
        <a class="login-back-link" href="{{ path('app_home') }}">← Retour à l'accueil</a>
    </header>

    <main class="login-page">
        <section class="login-intro">
            <p class="eyebrow"><span class="eyebrow-dot"></span> Votre espace WorkTogether</p>
            <h1>Rejoignez-nous<br><span>ensemble.</span></h1>
            <p class="login-intro-copy">
                Créez votre compte et accédez à un espace adapté à votre rôle.
            </p>
            <div class="login-benefit">
                <span class="note-icon" aria-hidden="true">✓</span>
                <span>Choisissez le profil qui vous correspond.</span>
            </div>
            <div class="login-decoration" aria-hidden="true">
                <span class="decoration-ring ring-small"></span>
                <span class="decoration-ring ring-large"></span>
                <span class="decoration-dot"></span>
                <span class="decoration-label">WORK TOGETHER</span>
            </div>
        </section>

        <section class="login-card signup-choice-card" aria-labelledby="signup-choice-title">
            <div class="login-card-heading">
                <p class="eyebrow">CRÉATION DE COMPTE</p>
                <h2 id="signup-choice-title">Comment souhaitez-vous vous inscrire ?</h2>
                <p>Sélectionnez le type de compte qui vous correspond.</p>
            </div>

            <fieldset class="signup-choices">
                <legend class="visually-hidden">Type de compte</legend>
                <label class="signup-choice">
                    <input id="client" type="radio" name="type_compte" value="client" checked>
                    <span class="signup-choice-icon" aria-hidden="true">C</span>
                    <span class="signup-choice-copy">
                        <strong>En tant que client</strong>
                        <span>Gérez vos baies et vos unités depuis votre espace.</span>
                    </span>
                    <span class="signup-choice-indicator" aria-hidden="true"></span>
                </label>

                <label class="signup-choice">
                    <input id="comptable" type="radio" name="type_compte" value="comptable">
                    <span class="signup-choice-icon" aria-hidden="true">€</span>
                    <span class="signup-choice-copy">
                        <strong>En tant que comptable</strong>
                        <span>Retrouvez et suivez les informations de facturation.</span>
                    </span>
                    <span class="signup-choice-indicator" aria-hidden="true"></span>
                </label>
            </fieldset>

                <a id="continue-signin"
                    href="{{ path('app_inscription_client') }}"
                    data-client-url="{{ path('app_inscription_client') }}"
                    data-comptable-url="{{ path('app_inscription_comptable') }}"
                    class="signup-choice-submit">
                        Continuer
                </a>

            <p class="login-help">Vous avez déjà un compte ? <a href="{{ path('app_connexion') }}">Se connecter</a></p>
        </section>
    </main>

    <footer class="login-footer">
        <span>© {{ "now"|date("Y") }} WorkTogether</span>
        <span>La technologie, en mieux.</span>
    </footer>
{% endblock %}
